<Project Sdk="Aspire.AppHost.Sdk/13.2.0">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>4d01f363-c990-4a2f-8c3f-63f87ad35616</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>

  <!-- Source development uses the combined host in src-single. Generated projects use src. -->
  <ItemGroup Condition="Exists('..\..\src-single\UI\AditiKraft.Krafter.UI.Web\AditiKraft.Krafter.UI.Web.csproj')">
    <ProjectReference Include="..\..\src-single\UI\AditiKraft.Krafter.UI.Web\AditiKraft.Krafter.UI.Web.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('..\..\src-single\UI\AditiKraft.Krafter.UI.Web\AditiKraft.Krafter.UI.Web.csproj')">
    <ProjectReference Include="..\..\src\UI\AditiKraft.Krafter.UI.Web\AditiKraft.Krafter.UI.Web.csproj" />
  </ItemGroup>

</Project>
