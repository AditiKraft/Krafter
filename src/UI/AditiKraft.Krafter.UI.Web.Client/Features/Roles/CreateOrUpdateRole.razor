@inherits AditiKraft.Krafter.UI.Web.Client.Common.Components.Dialogs.EditorDialogBase
<RadzenTemplateForm Data="@CreateUserRequest" Submit="@((CreateOrUpdateRoleRequest input) => SubmitAsync(input))" @onkeydown="OnEditorKeyDown">
    <FluentValidationValidator Options="@(options => options.IncludeAllRuleSets())"/>
    <fieldset disabled="@IsSaving" class="kr-editor-fields">
    <RadzenStack Gap="0.5rem" Orientation="Orientation.Vertical">

        <RadzenRow AlignItems="AlignItems.Center">
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenLabel Text="Name" Component="Name"/>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="8">
                <RadzenTextBox Style="width: 100%" Disabled="!string.IsNullOrWhiteSpace(UserDetails.Id)" @bind-Value="@CreateUserRequest.Name" Name="Name"/>
            </RadzenColumn>
            <ValidationMessage For="@(() => CreateUserRequest.Name)"/>
        </RadzenRow>

        <RadzenRow AlignItems="AlignItems.Center">
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenLabel Text="Description" Component="Description"/>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="8">
                <RadzenTextBox Style="width: 100%" @bind-Value="@CreateUserRequest.Description" Name="Description"/>
            </RadzenColumn>
            <ValidationMessage For="@(() => CreateUserRequest.Description)"/>
        </RadzenRow>

        @if (canViewPermissions)
        {
            @if (isLoadingPermissions)
            {
                <p role="status">Loading role permissions...</p>
            }
            else if (permissionLoadFailed)
            {
                <div role="alert">
                    <p>Could not load role permissions. @(canUpdatePermissions ? "Retry before editing permissions or saving." : "You can still save role details.")</p>
                    <RadzenButton ButtonType="ButtonType.Button" Text="Retry" Disabled="@IsSaving" Click="@LoadPermissionsAsync"/>
                </div>
            }

            <RadzenRow AlignItems="AlignItems.Center">
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenLabel Text="Permission" Component="FinalPermission"/>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="8">
                    <RadzenDropDown TValue="List<string>" Style="width: 100%" Value="@CreateUserRequest.Permissions" ValueChanged="@ChangePermissions" Multiple="true" AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Name="FinalPermission"
                                    Disabled="@(!CanEditPermissions)" Data="@GroupedData" DisabledProperty="IsGroup" ValueProperty="FinalPermission" TextProperty="FinalPermission" MaxSelectedLabels="1">
                        <Template Context="product">
                            @(product.Resource ?? product.FinalPermission)
                        </Template>
                    </RadzenDropDown>
                </RadzenColumn>
            </RadzenRow>
        }
    </RadzenStack>
    </fieldset>
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="0.5rem" Class="rz-mt-4 rz-mb-2">
        <RadzenButton ButtonType="ButtonType.Submit" Disabled="@(!CanSave)" IsBusy="IsSaving" Size="ButtonSize.Small" Icon="save" Text="Save" />
        <RadzenButton ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small" Icon="cancel" Text="Cancel" Disabled="@IsSaving" Click="@Cancel" />
    </RadzenStack>
</RadzenTemplateForm>
