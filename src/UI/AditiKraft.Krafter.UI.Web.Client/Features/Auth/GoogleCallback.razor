@page "/google-callback"
@using AditiKraft.Krafter.UI.Web.Client.Common.Components.Brand
@rendermode @(new InteractiveWebAssemblyRenderMode(false))
<div class="rz-p-4 rz-text-align-center">
    <RadzenCard class="rz-shadow-3 rz-border-radius-4 rz-p-4" style="max-width: 360px; margin: 0 auto;">
        <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem" AlignItems="AlignItems.Center">
            <Logo Size="LogoSize.Small"></Logo>
            <RadzenText TextStyle="TextStyle.H5">Processing your login</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-2">Please wait while we authenticate your account...</RadzenText>
            <LoadingIndicator Size="LoadingIndicatorSize.Small"></LoadingIndicator>
        </RadzenStack>
    </RadzenCard>
</div>
