@page "/login"
@page "/Account/Login"
@using AditiKraft.Krafter.Contracts.Contracts.Auth
<RadzenRow Gap="0" Class="kr-auth-panel">

    @if (IsMobileDevice == false)
    {
        <RadzenColumn Size="12" SizeMD="4">
            <RadzenCard Class="kr-auth-intro">
                <RadzenText TextStyle="TextStyle.H3" TagName="TagName.H2" Class="rz-mb-3">Welcome!</RadzenText>
                <RadzenText TextStyle="TextStyle.H6">Join the world's largest community!</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">Let's get started with your <strong>30 days</strong> trial.</RadzenText>
            </RadzenCard>
        </RadzenColumn>
    }

    <RadzenColumn Size="12" SizeMD="8">
        <RadzenCard Class="kr-auth-form">
            <RadzenText TextAlign="TextAlign.Center" TextStyle="TextStyle.H5" TagName="TagName.H2" Class="rz-mb-3">
                Login
            </RadzenText>

            <RadzenStack JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center">
                <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                              class="google-login-button" aria-label="Sign in with Google" Click="@StartGoogleLogin">
                    <RadzenImage Path="@(themeManager.CurrentActive == ThemeManager.ThemePreference.Light ? "login-with-google-dark.svg" : "login-with-google-light.svg")"
                                 AlternateText="" aria-hidden="true" />
                </RadzenButton>
            </RadzenStack>

            <RadzenText TextAlign="TextAlign.Center" TextStyle="TextStyle.Body1" Class="rz-my-2">
                Or
            </RadzenText>

            @if (!string.IsNullOrEmpty(DisplayError))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false" role="alert">@DisplayError</RadzenAlert>
            }
            @if (authenticationService.PendingChallenge is not null)
            {
                <RadzenText TagName="TagName.H2">Two-factor verification</RadzenText>
                <p>Enter your authenticator code. If you lost your authenticator, use one of your recovery codes.</p>
                <RadzenTemplateForm Data="@verification" Submit="@((TwoFactorRequest request) => VerifyTwoFactor(request))">
                    <RadzenLabel Text="Verification or recovery code" Component="VerificationCode" />
                    <RadzenTextBox Name="VerificationCode" @bind-Value="verification.Code" autocomplete="one-time-code" Style="width:100%" />
                    <div class="rz-my-3">
                        <RadzenCheckBox @bind-Value="verification.UseRecoveryCode" Name="UseRecoveryCode" />
                        <RadzenLabel Component="UseRecoveryCode" Text="Use a recovery code" />
                    </div>
                    <RadzenButton ButtonType="ButtonType.Submit" Text="Verify" IsBusy="isBusy" />
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@CancelVerification" Disabled="isBusy" />
                </RadzenTemplateForm>
            }
            else
            {
            <RadzenTemplateForm Data="@TokenRequestInput" Submit="@((TokenRequest __) => CreateToken(__))">
                <FluentValidationValidator Options="@(options => options.IncludeAllRuleSets())"/>
                <RadzenStack Gap="0.5rem">
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="12" SizeMD="2">
                            <RadzenLabel Text="Email" Component="Email"/>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="10">
                            <RadzenTextBox Style="width: 100%" @bind-Value="@TokenRequestInput.Email" Name="Email"/>
                        </RadzenColumn>
                        <ValidationMessage For="@(() => TokenRequestInput.Email)"/>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="12" SizeMD="2">
                            <RadzenLabel Text="Password" Component="Password"/>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="10">
                            <RadzenPassword Style="width: 100%" @bind-Value="@TokenRequestInput.Password" Name="Password"/>
                        </RadzenColumn>
                        <ValidationMessage For="@(() => TokenRequestInput.Password)"/>
                    </RadzenRow>
                    <RadzenLink Path="account/forgot-password" Text="Forgot Password?"></RadzenLink>
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right" Gap="0.5rem" Class="rz-mt-4 rz-mb-2">
                    <RadzenButton ButtonType="ButtonType.Submit" IsBusy="isBusy" Size="ButtonSize.Small" Icon="login" Text="Login" />
                </RadzenStack>
            </RadzenTemplateForm>
            }

        </RadzenCard>
    </RadzenColumn>
</RadzenRow>
