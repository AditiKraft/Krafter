@using AditiKraft.Krafter.UI.Web.Client.Features.Roles.Common
@inherits AditiKraft.Krafter.UI.Web.Client.Common.Components.Dialogs.EditorDialogBase
<RadzenTemplateForm Data="@CreateUserRequest" Submit="@((CreateUserRequest input) => SubmitAsync(input))" @onkeydown="OnEditorKeyDown">
    <FluentValidationValidator Options="@(options => options.IncludeAllRuleSets())" />
    <fieldset disabled="@IsSaving" class="kr-editor-fields">
    <RadzenStack>


        <RadzenRow AlignItems="AlignItems.Center">
            <RadzenColumn Size="12" SizeMD="2">
                <RadzenLabel Text="First Name" Component="FirstName" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="10">
                <RadzenTextBox Style="width: 100%" @bind-Value="@CreateUserRequest.FirstName" Name="FirstName" />
            </RadzenColumn>
            <ValidationMessage For="@(() => CreateUserRequest.FirstName)" />
        </RadzenRow>


        <RadzenRow AlignItems="AlignItems.Center">
            <RadzenColumn Size="12" SizeMD="2">
                <RadzenLabel Text="Last Name" Component="LastName" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="10">
                <RadzenTextBox Style="width: 100%" @bind-Value="@CreateUserRequest.LastName" Name="LastName" />
            </RadzenColumn>
            <ValidationMessage For="@(() => CreateUserRequest.LastName)" />
        </RadzenRow>


        <RadzenRow AlignItems="AlignItems.Center">
            <RadzenColumn Size="12" SizeMD="2">
                <RadzenLabel Text="Phone Number" Component="PhoneNumber" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="10">
                <RadzenTextBox Style="width: 100%" @bind-Value="@CreateUserRequest.PhoneNumber" Name="PhoneNumber" />
            </RadzenColumn>
            <ValidationMessage For="@(() => CreateUserRequest.PhoneNumber)" />
        </RadzenRow>

        @if (IsExisting && canViewRoles)
        {
            @if (isLoadingRoles)
            {
                <p role="status">Loading user roles...</p>
            }
            else if (roleLoadFailed)
            {
                <div role="alert">
                    <p>Could not load user roles. @(canUpdateRoles ? "Retry before editing roles or saving." : "You can still save profile changes.")</p>
                    <RadzenButton ButtonType="ButtonType.Button" Text="Retry" Disabled="@IsSaving" Click="@LoadRolesAsync" />
                </div>
            }
            <RadzenRow AlignItems="AlignItems.Center">
                <RadzenColumn Size="12" SizeMD="2">
                    <RadzenLabel Text="Roles" Component="Roles" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="10">
                    @if (canUpdateRoles)
                    {
                        <MultiSelectRoleDropDownDataGrid Value="@CreateUserRequest.Roles" ValueChanged="@ChangeRoles" Disabled="@(!CanEditRoles)" />
                    }
                    else if (rolesLoaded)
                    {
                        <span>@(originalRoles.Count == 0 ? "No roles" : string.Join(", ", userRoles.Where(role => role.Enabled).Select(role => role.RoleName)))</span>
                    }
                </RadzenColumn>
                <ValidationMessage For="@(() => CreateUserRequest.Roles)" />
            </RadzenRow>
            @if (EmptyRoleSelection)
            {
                <p role="alert">Keep at least one role selected. This editor cannot remove all roles.</p>
            }
        }


        <RadzenRow AlignItems="AlignItems.Center">
            <RadzenColumn Size="12" SizeMD="2">
                <RadzenLabel Text="Email" Component="Email" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="10">
                <RadzenTextBox Style="width: 100%" @bind-Value="@CreateUserRequest.Email" Name="Email" />
            </RadzenColumn>
            <ValidationMessage For="@(() => CreateUserRequest.Email)" />
        </RadzenRow>


    </RadzenStack>
    </fieldset>

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="0.5rem"
                 Class="rz-mt-4 rz-mb-2">
        <RadzenButton ButtonType="ButtonType.Submit" Disabled="@(!CanSave)" IsBusy="IsSaving" Size="ButtonSize.Small" Icon="save" Text="Save" />
        <RadzenButton ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small" Icon="cancel"
                      Text="Cancel" Disabled="@IsSaving" Click="@Cancel" />
    </RadzenStack>
</RadzenTemplateForm>
