@page "/account/forgot-password"
<RadzenRow Gap="0" Class="kr-auth-panel">
    <RadzenColumn Size="12" SizeMD="4">
        <RadzenCard Class="kr-auth-intro">
            <RadzenText TextStyle="TextStyle.H3" TagName="TagName.H2" Class="rz-mb-3">Welcome!</RadzenText>
            <RadzenText TextStyle="TextStyle.H6">Join the world's largest community!</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2">Let's get started with your <strong>30 days</strong> trial.</RadzenText>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="8">
        <RadzenCard Class="kr-auth-form" Style="height:100%">
            <RadzenText TextAlign="TextAlign.Center" TextStyle="TextStyle.H5" TagName="TagName.H2" Class="rz-mb-3">
                Forgot Password
            </RadzenText>
            @if (MailSent)
            {
                <RadzenText TextStyle="TextStyle.Body1" Class="rz-mb-3">
                    We have sent a password reset link to your email. Please check your inbox, as well as your spam or junk folder.
                </RadzenText>
            }
            else
            {
                <RadzenTemplateForm Data="@ForgotPasswordRequest" Submit="@((ForgotPasswordRequest __) => SendForgotPasswordMail(__))">
                    <FluentValidationValidator Options="@(options => options.IncludeAllRuleSets())"/>
                    <RadzenStack>
                        <RadzenStack Orientation="Orientation.Vertical" Style="padding:0px">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="2">
                                    <RadzenLabel Text="Email" Component="Email"/>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="10">
                                    <RadzenTextBox Style="width: 100%" @bind-Value="@ForgotPasswordRequest.Email" Name="Email"/>
                                </RadzenColumn>
                                <ValidationMessage For="@(() => ForgotPasswordRequest.Email)"/>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right" Gap="0.5rem" Class="rz-mt-4 rz-mb-2">
                        <RadzenButton ButtonType="ButtonType.Submit" IsBusy="IsBusy" Size="ButtonSize.Small" Icon="lock_open" Text="Submit" />
                    </RadzenStack>
                </RadzenTemplateForm>
            }
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>
