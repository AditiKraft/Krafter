@page "/account/reset-password"
<RadzenRow Gap="0" Class="kr-auth-panel">
    <RadzenColumn Size="12" SizeMD="4">
        <RadzenCard Class="kr-auth-intro">
            <RadzenText TextStyle="TextStyle.H3" TagName="TagName.H2" Class="rz-mb-6">Welcome!</RadzenText>
            <RadzenText TextStyle="TextStyle.H6">Join the world's largest community!</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2">Let's get started with your <strong>30 days</strong> trial.</RadzenText>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="8">
        <RadzenCard Class="kr-auth-form">
            <RadzenText TextAlign="TextAlign.Center" TextStyle="TextStyle.H5" TagName="TagName.H2" Class="rz-mb-6">
                Reset Password
            </RadzenText>
            <RadzenTemplateForm Data="@ResetPasswordRequest" Submit="@((ResetPasswordRequest __) => SubmitResetPassword(__))">
                <FluentValidationValidator Options="@(options => options.IncludeAllRuleSets())"/>
                <RadzenStack Gap="3">
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="12" SizeMD="2">
                            <RadzenLabel Text="Email" Component="Email"/>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="10">
                            <RadzenTextBox Style="width: 100%" @bind-Value="@ResetPasswordRequest.Email" Name="Email"/>
                        </RadzenColumn>
                        <ValidationMessage For="@(() => ResetPasswordRequest.Email)"/>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="12" SizeMD="2">
                            <RadzenLabel Text="Password" Component="Password"/>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="10">
                            <RadzenPassword Style="width: 100%" @bind-Value="@ResetPasswordRequest.Password" Name="Password"/>
                        </RadzenColumn>
                        <ValidationMessage For="@(() => ResetPasswordRequest.Password)"/>
                    </RadzenRow>
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right" Gap="1rem" Class="rz-mt-8 rz-mb-4">
                    <RadzenButton ButtonType="ButtonType.Submit" IsBusy="IsBusy" Size="ButtonSize.Medium" Icon="password" Text="Reset"/>
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>
